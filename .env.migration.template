# ============================================================================
# SIXTHGEAR MOTO - ENVIRONMENT VARIABLES TEMPLATE
# Migration: Medusa + Strapi → Shopify + Payload CMS 3.0
# ============================================================================
# Created: 2026-02-23
# Status: Migration Phase 2 - Planning
# 
# INSTRUCTIONS:
# 1. Copy this file to .env.local: cp .env.migration.template .env.local
# 2. Fill in all required values (marked with YOUR_*)
# 3. Never commit .env.local to version control
# 4. Keep production values separate and secure
# ============================================================================

# ============================================================================
# SHOPIFY CONFIGURATION
# ============================================================================
# Shopify is your complete commerce backend - products, cart, checkout, orders

# Shopify Store Domain
# Format: your-store.myshopify.com (without https://)
# Get from: Shopify Admin → Settings → Store details
SHOPIFY_STORE_DOMAIN=YOUR_STORE_NAME.myshopify.com

# Shopify Storefront API Access Token (PUBLIC - for product catalog, cart)
# This is safe to expose in client-side code
# Get from: Shopify Admin → Apps → Develop apps → Create app → 
#           Configure Storefront API scopes → Install app
# Required scopes:
#   - unauthenticated_read_product_listings
#   - unauthenticated_write_checkouts
#   - unauthenticated_read_checkouts
#   - unauthenticated_write_customers
#   - unauthenticated_read_customers
#   - unauthenticated_read_customer_tags
#   - unauthenticated_read_content
#   - unauthenticated_read_metaobjects
#   - unauthenticated_read_product_tags
SHOPIFY_STOREFRONT_ACCESS_TOKEN=YOUR_STOREFRONT_ACCESS_TOKEN

# Shopify Admin API Access Token (PRIVATE - server-only operations)
# Only needed for admin operations like inventory sync, order management
# Get from: Same app → Configure Admin API scopes → Install app
# Keep this SECRET - never expose in client code
SHOPIFY_ADMIN_ACCESS_TOKEN=YOUR_ADMIN_ACCESS_TOKEN

# Shopify Webhook Secret
# Used to verify webhook authenticity from Shopify
# Get from: Shopify Admin → Settings → Notifications → Webhooks
SHOPIFY_WEBHOOK_SECRET=YOUR_WEBHOOK_SECRET

# Shopify Shop ID (Numeric)
# Your unique Shopify store identifier
# Get from: Shopify Admin → Settings → Store details (numeric ID in URL)
SHOPIFY_SHOP_ID=YOUR_SHOP_ID

# Shopify API Version
# Use the latest stable version for best features
# See: https://shopify.dev/docs/api/usage/versioning
SHOPIFY_API_VERSION=2025-01

# ============================================================================
# SHOPIFY CUSTOMER ACCOUNT API (OAuth 2.0 / OIDC)
# ============================================================================
# Enables SSO between your storefront and Shopify checkout
# Customers authenticate once and stay logged in through checkout

# OAuth Client ID
# Get from: Shopify Admin → Apps → Your app → Customer Account API
SHOPIFY_CLIENT_ID=YOUR_CLIENT_ID

# OAuth Client Secret (PRIVATE)
# Keep this SECRET - never expose in client code
SHOPIFY_CLIENT_SECRET=YOUR_CLIENT_SECRET

# OAuth Redirect URLs (configure in Shopify)
# Development: http://localhost:3000/api/auth/callback/shopify
# Production: https://sixthgearmoto.com/api/auth/callback/shopify

# ============================================================================
# NEXTAUTH.JS CONFIGURATION
# ============================================================================
# Handles customer authentication with Shopify OAuth

# NextAuth Secret (REQUIRED - PRIVATE)
# Generate a strong random secret (32+ characters)
# Generate with: openssl rand -base64 32
# Or use: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET=YOUR_32_CHAR_RANDOM_SECRET_HERE

# NextAuth URL
# Your site's base URL
# Development: http://localhost:3000
# Production: https://sixthgearmoto.com
NEXTAUTH_URL=http://localhost:3000

# NextAuth Debug Mode (Development only)
# Set to true to see detailed auth logs
# NEVER enable in production
NEXTAUTH_DEBUG=false

# ============================================================================
# PAYLOAD CMS 3.0 CONFIGURATION
# ============================================================================
# Payload CMS manages all content (pages, blog, banners, settings)
# Embedded in Next.js - no separate server needed

# Payload Secret (REQUIRED - PRIVATE)
# Used to encrypt sensitive data and sign JWTs
# Generate with: openssl rand -base64 32
PAYLOAD_SECRET=YOUR_32_CHAR_PAYLOAD_SECRET_HERE

# Database Connection String (PostgreSQL)
# Payload requires PostgreSQL for data storage
# Recommended: Neon (https://neon.tech) - free tier available
# Format: postgresql://user:password@host:port/database?sslmode=require
# Example: postgresql://user:pass@ep-cool-darkness-123456.us-east-2.aws.neon.tech/sixthgear?sslmode=require
DATABASE_URI=postgresql://YOUR_USER:YOUR_PASSWORD@YOUR_HOST/YOUR_DATABASE?sslmode=require

# Payload Admin Path
# URL path for Payload admin panel
# Default: /admin
# Access at: http://localhost:3000/admin
PAYLOAD_ADMIN_PATH=/admin

# ============================================================================
# PAYMENT CONFIGURATION - XENDIT (Philippine Payment Methods)
# ============================================================================
# Xendit handles GCash, Maya, Cards, OTC, and other PH payment methods
# Integrated via Shopify app - no custom checkout code needed

# Xendit Secret Key (PRIVATE)
# Get from: Xendit Dashboard → Settings → API Keys → Secret Key
# Development: Use test mode key (starts with xnd_development_)
# Production: Use live mode key (starts with xnd_production_)
XENDIT_SECRET_KEY=YOUR_XENDIT_SECRET_KEY

# Xendit Webhook Verification Token (PRIVATE)
# Used to verify webhook authenticity from Xendit
# Get from: Xendit Dashboard → Settings → Webhooks → Verification Token
XENDIT_WEBHOOK_TOKEN=YOUR_XENDIT_WEBHOOK_TOKEN

# Xendit Public Key (PUBLIC - for client-side operations)
# Only needed if implementing custom payment UI (not recommended for v1)
# Get from: Xendit Dashboard → Settings → API Keys → Public Key
XENDIT_PUBLIC_KEY=YOUR_XENDIT_PUBLIC_KEY

# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# --- Resend (Transactional Emails) ---
# For custom emails not handled by Shopify/Klaviyo
# Examples: contact form responses, custom notifications
# Get from: https://resend.com → API Keys
RESEND_API_KEY=YOUR_RESEND_API_KEY

# Verified sending domain
# Must verify domain in Resend dashboard first
# Example: hello@sixthgearmoto.com
RESEND_FROM_EMAIL=hello@sixthgearmoto.com

# --- Klaviyo (Marketing Automation) ---
# Installed as Shopify app - handles abandoned cart, welcome series, etc.
# API key only needed for custom integrations
# Get from: Klaviyo → Account → Settings → API Keys
KLAVIYO_API_KEY=YOUR_KLAVIYO_API_KEY
KLAVIYO_LIST_ID=YOUR_KLAVIYO_LIST_ID

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================

# Site URL (PUBLIC)
# Your site's base URL - used for canonical URLs, OG images, sitemaps
# Development: http://localhost:3000
# Production: https://sixthgearmoto.com
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Site Name (PUBLIC)
# Your store's display name
NEXT_PUBLIC_SITE_NAME=Sixthgear Moto Supply & Café

# Default Locale (PUBLIC)
# Primary language/region for the store
# Philippine market: en-PH or just 'ph'
NEXT_PUBLIC_DEFAULT_LOCALE=ph

# Currency (PUBLIC)
# ISO 4217 currency code
# Philippine Peso: PHP
NEXT_PUBLIC_CURRENCY=PHP

# Currency Symbol (PUBLIC)
# Display symbol for prices
NEXT_PUBLIC_CURRENCY_SYMBOL=₱

# ============================================================================
# STORAGE CONFIGURATION
# ============================================================================

# Vercel Blob Storage (for Payload CMS media uploads)
# Get from: Vercel Dashboard → Storage → Create Blob Store → Copy token
# Automatically available in Vercel deployments
BLOB_READ_WRITE_TOKEN=YOUR_VERCEL_BLOB_TOKEN

# Alternative: AWS S3 (if not using Vercel Blob)
# AWS_ACCESS_KEY_ID=YOUR_AWS_ACCESS_KEY
# AWS_SECRET_ACCESS_KEY=YOUR_AWS_SECRET_KEY
# AWS_REGION=ap-southeast-1
# AWS_S3_BUCKET=sixthgear-media

# ============================================================================
# ISR & CACHING CONFIGURATION
# ============================================================================

# Revalidation Secret (PRIVATE)
# Used to trigger on-demand revalidation of Next.js cache
# Generate with: openssl rand -base64 32
# Called via: POST /api/revalidate with header: x-revalidate-secret
REVALIDATION_SECRET=YOUR_REVALIDATION_SECRET

# Cache TTL (seconds)
# How long to cache Shopify data before revalidating
# Recommended: 60 seconds for product pages
CACHE_TTL=60

# ============================================================================
# ANALYTICS & MONITORING
# ============================================================================

# Google Analytics 4
# Get from: Google Analytics → Admin → Data Streams → Measurement ID
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX

# Google Tag Manager (Optional)
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Vercel Analytics (Automatically enabled in Vercel deployments)
# No configuration needed

# Sentry Error Tracking (Optional)
# Get from: https://sentry.io → Settings → Projects → Client Keys (DSN)
NEXT_PUBLIC_SENTRY_DSN=YOUR_SENTRY_DSN
SENTRY_AUTH_TOKEN=YOUR_SENTRY_AUTH_TOKEN

# ============================================================================
# FEATURE FLAGS
# ============================================================================

# Maintenance Mode
# Set to "true" to show maintenance page
# Only affects production - local development unaffected
MAINTENANCE_MODE=false

# Enable Preview Mode
# Allow previewing draft content from Payload CMS
ENABLE_PREVIEW_MODE=true

# Enable Search
# Toggle Shopify search functionality
ENABLE_SEARCH=true

# Enable Wishlist
# Toggle wishlist feature (stored in customer metafields)
ENABLE_WISHLIST=true

# Enable Reviews
# Toggle product reviews (requires Judge.me or Yotpo integration)
ENABLE_REVIEWS=true

# ============================================================================
# DEVELOPMENT & DEBUGGING
# ============================================================================

# Node Environment
# Automatically set by Next.js
# Values: development | production | test
NODE_ENV=development

# Enable Debug Logging
# Show detailed logs in development
DEBUG=false

# Disable Telemetry
# Opt out of Next.js anonymous telemetry
NEXT_TELEMETRY_DISABLED=1

