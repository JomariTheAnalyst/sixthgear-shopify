# ============================================================================
# SHOPIFY STOREFRONT API - ESSENTIAL FOR NEXT.JS CONNECTION
# ============================================================================

# Your Shopify store domain (without https://)
SHOPIFY_STORE_DOMAIN=your-store-name.myshopify.com

# Storefront API Access Token (PRIVATE - server-side only)
# This is your main token for fetching products, collections, cart operations
SHOPIFY_STOREFRONT_ACCESS_TOKEN=your_storefront_access_token

# Storefront API Public Token (safe for client-side)
# Used for client-side cart operations if needed
NEXT_PUBLIC_SHOPIFY_STOREFRONT_TOKEN=your_public_storefront_token

# Shopify API Version (use latest stable)
SHOPIFY_API_VERSION=2025-10

# ============================================================================
# SHOPIFY ADMIN API (Optional - for admin operations)
# ============================================================================
SHOPIFY_ADMIN_ACCESS_TOKEN=your_admin_access_token
SHOPIFY_WEBHOOK_SECRET=your_shopify_webhook_secret

# ============================================================================
# SHOPIFY CUSTOMER ACCOUNT API (For NextAuth - will set up later)
# ============================================================================
SHOPIFY_CLIENT_ID=your_shopify_client_id
SHOPIFY_CLIENT_SECRET=your_shopify_client_secret
# TODO: Get real shop ID from Shopify Admin URL or Customer Account API endpoints
SHOPIFY_SHOP_ID=your_shop_id

# ============================================================================
# JUDGEME REVIEWS API
# ============================================================================
NEXT_PUBLIC_JUDGEME_PUBLIC_TOKEN=your_judgeme_public_token
JUDGEME_PRIVATE_TOKEN=your_judgeme_private_token
NEXT_PUBLIC_JUDGEME_SHOP_DOMAIN=your-store-name.myshopify.com

# ============================================================================
# NEXTAUTH (Will configure later when setting up authentication)
# ============================================================================
NEXTAUTH_SECRET=your_strong_nextauth_secret_here
NEXTAUTH_URL=http://localhost:7000

# ============================================================================
# APP CONFIG
# ============================================================================
NEXT_PUBLIC_SITE_URL=http://localhost:7000
NEXT_PUBLIC_SITE_NAME="Sixthgear Moto"

# ============================================================================
# SANITY CMS CONFIG
# ============================================================================
NEXT_PUBLIC_SANITY_PROJECT_ID=your_sanity_project_id
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2025-03-09
SANITY_REVALIDATE_SECRET=your_sanity_revalidate_secret
SANITY_WEBHOOK_SECRET=your_sanity_webhook_secret

# ============================================================================
# UPSTASH REDIS CONFIG
# ============================================================================
UPSTASH_REDIS_REST_URL="https://your-upstash-redis-url.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_rest_token"
